#!/bin/sh
# Global pre-commit: block added lines that are >200 chars, contain a space, and contain "Math".
# Catches obfuscated JS appended to otherwise normal files. Bypass once with: git commit --no-verify

# Colors only when stderr is a terminal and NO_COLOR is not set.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  RED="$(printf '\033[1;31m')"
  YEL="$(printf '\033[1;33m')"
  GRN="$(printf '\033[1;32m')"
  CYN="$(printf '\033[36m')"
  DIM="$(printf '\033[2m')"
  RST="$(printf '\033[0m')"
else
  RED=""
  YEL=""
  GRN=""
  CYN=""
  DIM=""
  RST=""
fi

echo "${CYN}[global pre-commit]${RST} ${DIM}scanning staged lines...${RST}" >&2

# awk prints findings to stderr and exits 1 if any suspicious line is found.
git diff --cached --diff-filter=ACM -U0 --no-color | awk \
  -v red="$RED" -v yel="$YEL" -v cyn="$CYN" -v dim="$DIM" -v rst="$RST" '
  /^\+\+\+ / { file = substr($0, 7); next }
  /^@@ /     { match($0, /\+[0-9]+/); ln = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
  /^\+/ {
    line = substr($0, 2)
    if (length(line) > 200 && index(line, " ") && index(line, "Math")) {
      if (file != last) {
        printf "\n%s%s%s\n", yel, file, rst > "/dev/stderr"
        last = file
      }
      preview = substr(line, 1, 70)
      gsub(/\t/, " ", preview)
      printf "  %s->%s line %s%d%s %s(%d chars)%s  %s%s...%s\n", \
        red, rst, cyn, ln, rst, dim, length(line), rst, dim, preview, rst > "/dev/stderr"
      bad = 1
      count++
    }
    ln++
  }
  END {
    if (bad) printf "\n%s%d suspicious line(s)%s (>200 chars, contains spaces and \"Math\")\n", red, count, rst > "/dev/stderr"
    exit bad
  }
' || {
  echo "${RED}x commit blocked.${RST} Inspect the file -> line above, or bypass once with ${YEL}git commit --no-verify${RST}." >&2
  exit 1
}

echo "${GRN}ok${RST} ${DIM}no suspicious lines${RST}" >&2

# Chain to the repo's local hook (ignored by git once core.hooksPath is set).
local_hook="$(git rev-parse --git-path hooks/pre-commit 2>/dev/null)"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

if [ -n "$local_hook" ] && [ -x "$local_hook" ]; then
  local_abs="$(cd "$(dirname "$local_hook")" && pwd)/$(basename "$local_hook")"
  # Guard against recursion if the local hook is this same file (e.g. symlink).
  if [ "$local_abs" != "$self" ]; then
    exec "$local_hook" "$@"
  fi
fi

exit 0
