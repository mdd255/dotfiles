{
  "bar": {
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "HH:mm ddd dd.MM.yy",
          "interval": 60
        },
        {
          "exec": "~/.config/dotfiles/omarchy/scripts/world-clock.js NYC=America/New_York",
          "fontSize": 14,
          "horizontalMargin": 8,
          "verticalPadding": 4,
          "id": "world-clock",
          "interval": 60,
          "type": "command"
        },
        {
          "exec": "~/.config/dotfiles/omarchy/scripts/khal-custom.js",
          "fontSize": 14,
          "horizontalMargin": 8,
          "verticalPadding": 4,
          "id": "events",
          "interval": 60,
          "onClick": "~/.config/dotfiles/omarchy/scripts/khal-view.js",
          "type": "command"
        }
      ],
      "left": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "right": [
        {
          "exec": "~/.config/dotfiles/omarchy/scripts/vpn.js status",
          "fontSize": 14,
          "horizontalMargin": 8,
          "id": "vpn",
          "interval": 5,
          "onClick": "~/.config/dotfiles/omarchy/scripts/vpn.js toggle",
          "type": "command"
        },
        {
          "exec": "fcitx5-remote -n | sed -E 's/^bamboo.*/\uf52a/; s/^keyboard-.*/\uf456/'",
          "id": "input-method",
          "interval": 3,
          "onClick": "~/.config/dotfiles/omarchy/scripts/fcit5-custom.js",
          "type": "command"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "superwhisper.panel"
        },
        {
          "id": "omarchy.monitor"
        }
      ],
      "tray": [],
      "centerBegin": [],
      "centerEnd": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 1200,
    "screensaver": 900
  },
  "version": 1,
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.elsewhen",
    "omarchy.reminders",
    "omarchy.image-picker",
    "omarchy.dev-gallery",
    "omarchy.speedtest",
    "omarchy.disk-speedtest",
    "omarchy.wifiqr",
    "omarchy.remote-session"
  ],
  "plugins": []
}
