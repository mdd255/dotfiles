{
  "bar": {
    "layout": {
      "center": [
        {
          "exec": "~/.config/dotfiles/omarchy/scripts/khal-custom.js 2>/dev/null",
          "id": "events",
          "interval": 60,
          "onClick": "~/.config/dotfiles/omarchy/scripts/khal-view.js",
          "type": "command"
        }
      ],
      "left": [],
      "right": [
        {
          "exec": "fcitx5-remote -n | sed -E 's/^bamboo.*//; s/^keyboard-.*//'",
          "id": "input-method",
          "interval": 1,
          "onClick": "~/.config/dotfiles/omarchy/scripts/fcit5-custom.js",
          "type": "command"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 180
  },
  "version": 1,
  "disabledPlugins": [
    "omarchy.emojis",
    "omarchy.elsewhen",
    "omarchy.reminders",
    "omarchy.image-picker",
    "omarchy.dev-gallery"
  ],
  "plugins": []
}
